# Copy to .env (never commit .env - it is in .gitignore). All values optional.
# Google Sheets sync: the "/exec" URL of your Apps Script web app (see README > Google Sheets sync).
SHEETS_WEBHOOK_URL=
# META_STORES=biorootlabs.com,metabolae.com   # Meta pass only for these (default: every watchlist store, least recently scraped first)
# META_MAX_MINUTES=90            # budget when `run` includes the Meta pass by hand (the night task uses META_NIGHT_MINUTES=600)
# META_MAX_SCROLLS=20            # scrolls per store page (20 ~ 350 newest ads, ~2-3 min per store)
# META_ADS=1                     # let `run` scrape the Meta Ad Library after the catalogue pass
# META_WAIT_MIN=3 / META_WAIT_MAX=8   # polite random pause between scrolls, seconds
# META_CHROMIUM_PATH=            # only if `python -m playwright install chromium` is not possible
# CATALOGUE_MAX_PAGES=60         # product pages read per run on sitemap-only platforms (generic, Wix, BigCommerce)
# CATALOGUE_REFRESH_DAYS=3 / CATALOGUE_REDETECT_DAYS=14
# CALIBRATION_PATH=calibration/shop_ids.csv   # shop_id,created_date rows for the store age estimate
# TRACKER_DB=data/tracker.db     # override SQLite path
# REQUEST_DELAY_S=1.0            # polite pause between paginated requests to the same store
# USER_AGENT=                    # override the default User-Agent

# ---- pdp.py (competitor PDP cloner; see README > PDP cloner) ----
# ANTHROPIC_API_KEY=            # Claude turns the scraped facts into a marketing brief + writes the Fudge guide (optional but recommended)
# ANTHROPIC_MODEL=claude-opus-5
# Higgsfield has two routes; pdp.py supports both (HIGGSFIELD_BACKEND=api|cli, default api when HF_KEY is set, else cli):
#   api = developer API on platform.higgsfield.ai, pay-per-use key from https://cloud.higgsfield.ai
#   cli = the `higgsfield` CLI on your normal Higgsfield account (`higgsfield auth login`), with product-photoshoot
# HF_KEY=key:secret             # api backend (or HF_API_KEY + HF_API_SECRET)
# HIGGSFIELD_BACKEND=cli
# HIGGSFIELD_CLI_MODEL=nano_banana_2            # cli backend model id (`higgsfield model list --json`); `generate --photoshoot <mode>` ignores it
# HIGGSFIELD_CLI_EXTRA=                         # extra flags appended verbatim to every CLI call
# HIGGSFIELD_MODEL=bytedance/seedream/v4/edit   # model id that accepts reference images; check the model page on cloud.higgsfield.ai
# HIGGSFIELD_IMAGE_ARG=image_urls               # request field that carries the reference URLs for that model
# HIGGSFIELD_NUM_IMAGES=4 / HIGGSFIELD_ASPECT=1:1 / HIGGSFIELD_RESOLUTION=2K / HIGGSFIELD_MAX_REFS=6
# HIGGSFIELD_EXTRA_ARGS={"seed": 42}            # JSON merged into every request
# SHOPIFY_STORE=my-brand.myshopify.com          # the *.myshopify.com domain, not the custom domain
# Dev Dashboard app (README > PDP cloner > Shopify app): Client ID + Client secret; pdp.py mints the 24 h token itself
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_TOKEN=shpat_...                 # only for a legacy admin-created app (token shown once); leave empty otherwise
# SHOPIFY_API_VERSION=2025-07
# SHOPIFY_TOKEN_CACHE=data/shopify_token.json   # where the minted token is cached (gitignored)
# PDP_TEMPLATE=templates/pdp_template.md        # default reference PDP template for `guide`
# PDP_OUTPUT_DIR=pdp_output                     # where each product folder is created

# ---- adspy.py (Adspy video puller; see README > Adspy video puller) ----
# ADSPY_SHEET_ID=1O35L85zhY_5WMnsG8gEKN0bKx7oziTUMlbn6r3TJ1J0   # the sheet (from its URL); must be shared 'Anyone with the link: Viewer'
# ADSPY_SHEET_GID=395636284                     # the tab: '#gid=' in the URL while the tab is open
# ADSPY_SHEET_TAB=Main TikTok Prods V2          # tab name, used when the gid does not resolve
# ADSPY_PRODUCT_COLUMN=Product Name / ADSPY_LINK_COLUMN=Adspy
# ADSPY_OUTPUT_DIR=adspy_output                 # one folder per product under here
# ADSPY_COOKIES_FROM_BROWSER=chrome             # Instagram reels need a logged-in session: chrome | edge | firefox (close the browser first on Windows)
# ADSPY_COOKIES=cookies.txt                     # or a Netscape cookies.txt export instead of the browser
# ADSPY_PAUSE_S=2 / ADSPY_RETRIES=3
# ADSPY_FORMAT=                                 # raw yt-dlp -f expression; default rejects watermarked formats and takes the best of the rest
# ADSPY_DEDUP=1 / ADSPY_DEDUP_ACROSS=1          # after the downloads: delete duplicate videos and leftovers; ACROSS=0 keeps one copy per product rather than per sheet
# ADSPY_STRIP_METADATA=1                        # 0 = keep the files' metadata (default: every tag removed after the downloads, stream copy)
# ADSPY_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe           # only when ffmpeg is not on PATH
