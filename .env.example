# Copy to .env (never commit .env - it is in .gitignore). All values optional.
# Google Sheets sync: the "/exec" URL of your Apps Script web app (see README > Google Sheets sync).
SHEETS_WEBHOOK_URL=
# META_ADS=1                    # let `run` scrape the Meta Ad Library after the Shopify pass (Part B)
# META_WAIT_MIN=3 / META_WAIT_MAX=8   # polite random pause between scrolls, seconds
# META_CHROMIUM_PATH=          # only if `python -m playwright install chromium` is not possible
# META_ACCESS_TOKEN=            # official Ad Library API (not wired yet)
# ALERT_WEBHOOK_URL=            # build step 5: Slack/Discord webhook
# TRACKER_DB=data/tracker.db    # override SQLite path
# REQUEST_DELAY_S=1.0           # polite pause between paginated requests to the same store
# USER_AGENT=                   # override the default User-Agent
