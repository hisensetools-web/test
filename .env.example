# Copy to .env (never commit .env - it is in .gitignore). All values optional.
# Google Sheets sync: the "/exec" URL of your Apps Script web app (see README > Google Sheets sync).
SHEETS_WEBHOOK_URL=
# INVENTORY_STORES=neuro-bella.com,tryorgatics.com,metabolae.com,holior.com   # probe these stores' stock daily (INVENTORY=1 = all);
#                                # stores whose products.json shows inventory_management=shopify join the pool by themselves
# META_DETAIL_MAX=60              # single-ad Ad Library pages per store per day (end_date, page likes, creatives)
# META_STORES=biorootlabs.com,metabolae.com   # Meta pass only for these (default: every watchlist store, rotating)
# META_MAX_MINUTES=90            # budget when `run` includes the Meta pass by hand (the night task uses META_NIGHT_MINUTES=480)
# META_MAX_SCROLLS=40            # scrolls per page (40 ~ 700 newest ads, ~4 min); META_DETAIL_MAX=30 single-ad pages per store
# META_ADS=1                    # let `run` scrape the Meta Ad Library after the Shopify pass (Part B)
# META_WAIT_MIN=3 / META_WAIT_MAX=8   # polite random pause between scrolls, seconds
# META_CHROMIUM_PATH=          # only if `python -m playwright install chromium` is not possible
# RADAR_MAX_MINUTES=240         # budget for one `radar` run (sweeps on Sundays + daily triage)
# RADAR_MAX_AGE_DAYS=180 / RADAR_MIN_ACTIVE_ADS=10   # promote when (age <= 180 d OR hot new product) AND active ads >= 10
# RADAR_MAX_ADS_PER_QUERY=500 / RADAR_COUNTRY=US      # depth of each hook / copycat search
# RADAR_MAX_COPYCAT_QUERIES=60 / RADAR_MAX_WEB_QUERIES=40 / RADAR_MAX_TRIAGE=40   # per run; the rest rotate to the next run
# RADAR_FUNNEL_MIN_ADS=3 / RADAR_CHECK_WORKERS=6 / RADAR_RESEARCH_DAYS=7 / RADAR_REFRESH_DAYS=7 / RADAR_TRIAGE_MINUTES=60
# RADAR_SWEEP_WEEKDAY=6         # 6 = Sunday; RADAR_WEB_SEARCH=0 disables the web search leg of the copycat sweep
# CATALOGUE_MAX_PAGES=60          # product pages read per run on sitemap-only platforms (generic, Wix, BigCommerce)
# CATALOGUE_REFRESH_DAYS=3 / CATALOGUE_REDETECT_DAYS=14
# META_ACCESS_TOKEN=            # official Ad Library API (not wired yet)
# ALERT_WEBHOOK_URL=            # build step 5: Slack/Discord webhook
# TRACKER_DB=data/tracker.db    # override SQLite path
# REQUEST_DELAY_S=1.0           # polite pause between paginated requests to the same store
# USER_AGENT=                   # override the default User-Agent

# ---- pdp.py (competitor PDP cloner; see README > PDP cloner) ----
# ANTHROPIC_API_KEY=            # Claude turns the scraped facts into a marketing brief + writes the Fudge guide (optional but recommended)
# ANTHROPIC_MODEL=claude-opus-5
# HF_KEY=key:secret             # Higgsfield Cloud, from https://cloud.higgsfield.ai (or HF_API_KEY + HF_API_SECRET)
# HIGGSFIELD_MODEL=bytedance/seedream/v4/edit   # model id that accepts reference images; check the model page on cloud.higgsfield.ai
# HIGGSFIELD_IMAGE_ARG=image_urls               # request field that carries the reference URLs for that model
# HIGGSFIELD_NUM_IMAGES=4 / HIGGSFIELD_ASPECT=1:1 / HIGGSFIELD_RESOLUTION=2K / HIGGSFIELD_MAX_REFS=6
# HIGGSFIELD_EXTRA_ARGS={"seed": 42}            # JSON merged into every request
# SHOPIFY_STORE=my-brand.myshopify.com          # custom app with write_products + write_files scopes
# SHOPIFY_ADMIN_TOKEN=shpat_...
# SHOPIFY_API_VERSION=2025-07
# PDP_TEMPLATE=templates/pdp_template.md        # default reference PDP template for `guide`
# PDP_OUTPUT_DIR=pdp_output                     # where each product folder is created
